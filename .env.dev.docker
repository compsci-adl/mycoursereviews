# PostgreSQL connection string 
DATABASE_URL="postgresql://postgres:postgres@mycoursereviews-db-dev:5432/mycoursereviews"

# Courses SQLite DB path
COURSES_DB_PATH="/data/courses-api/local.sqlite3"

# NextAuth core configuration
AUTH_SECRET="your-docker-dev-secret-key-goes-here-32chars"
NEXTAUTH_URL="http://localhost:3200"

# Keycloak config
KEYCLOAK_CLIENT_ID="mycoursereviews"
KEYCLOAK_CLIENT_SECRET="**********"
KEYCLOAK_ISSUER="http://mycoursereviews-keycloak:8080/realms/cs-club"

# Public Keycloak URLs
NEXT_PUBLIC_CONTAINER_KEYCLOAK_ENDPOINT="http://mycoursereviews-keycloak:8080"
NEXT_PUBLIC_LOCAL_KEYCLOAK_URL="http://localhost:8080"